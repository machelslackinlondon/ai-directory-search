# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Storage. Defaults to data/directory.json.
DIRECTORY_DATA_PATH=data/directory.json

# Admin guard. In production this must be set for import, upsert, delete, and reindex.
# In local development, mutating routes are allowed when this is empty.
ADMIN_TOKEN=

# Optional local semantic mode. Disabled by default.
# Set to local-hash for a no-cost deterministic vector-style rank boost.
SEMANTIC_PROVIDER=

# Optional future external providers. The app does not require these.
AI_PROVIDER=
AI_API_KEY=
VECTOR_PROVIDER=
VECTOR_API_KEY=
